# ==============================================================================
# MANAVASATHI — ENVIRONMENT VARIABLES SETUP GUIDE
# ==============================================================================
# If these variables are not set, ManavaSathi operates in honest DEMO MODE
# with pre-loaded, clearly labeled demonstration points across India.

# ------------------------------------------------------------------------------
# 1. Firebase Authentication & Cloud Firestore (Optional for Live Production)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# ------------------------------------------------------------------------------
# 2. Mapping Provider Configuration (Default: OpenStreetMap with Leaflet)
# ------------------------------------------------------------------------------
# Default uses open OpenStreetMap tiles.
# If using Google Maps or custom Mapbox styles, specify here:
VITE_MAP_PROVIDER=osm
# VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_KEY

# ------------------------------------------------------------------------------
# 3. Razorpay Payments Integration (Optional for Real Monetary Donations)
# ------------------------------------------------------------------------------
# Never include Key Secret in frontend code!
# Key ID is safe for frontend checkout; secret belongs in backend functions.
VITE_RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
